generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── MAIN DB: Organizations, Billing, SuperAdmin ────────────────────────────

model Organization {
  id   String @id @default(uuid())
  name String

  // tenant connection
  dbUrl      String?
  dbStrategy DbStrategy @default(DEDICATED)

  // plan & limits
  plan        OrgPlan   @default(FREE)
  status      OrgStatus @default(TRIAL)
  maxUsers    Int       @default(10)
  maxProjects Int       @default(5)

  // profile
  logoUrl    String?
  themeColor String?  @default("#3B82F6")
  industry   String?
  size       String?
  website    String?
  country    String?
  timezone   String?  @default("Asia/Kolkata")

  // contact & billing
  billingEmail        String?
  primaryContactName  String?
  primaryContactPhone String?
  address             String?

  // org-level settings
  requireApproval      Boolean @default(false)
  allowClientSignup    Boolean @default(false)
  sessionTimeoutMinutes Int?

  customFeatures Json?

  // trial/suspension
  trialEndsAt     DateTime?
  suspendedAt     DateTime?
  suspendedReason String?

  // metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]
  users    User[]
  activityLogs ActivityLog[]
}

// Auth lookup table — keeps email + passwordHash for all users across all tenants
model User {
  id             String  @id @default(uuid())
  email          String  @unique
  name           String
  passwordHash   String
  role           Role

  isApproved         Boolean  @default(false)
  mustChangePassword Boolean  @default(true)

  resetToken       String?
  resetTokenExpiry DateTime?

  // link to organization in MAIN DB
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  activityLogs ActivityLog[]
  notifications Notification[]

  createdAt DateTime @default(now())
}

model Notification {
  id     String @id @default(uuid())
  userId String

  title   String
  message String
  type    String
  link    String?
  isRead  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model Invoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  amount      Decimal      @db.Decimal(10, 2)
  currency    String       @default("USD")
  status      InvoiceStatus @default(PENDING)
  description String?
  plan        OrgPlan?

  dueDate DateTime?
  paidAt  DateTime?

  createdAt DateTime @default(now())
}

model PlatformSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

// ─── Enums ──────────────────────────────────────────────────────────────────

enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  MEMBER
  CLIENT
}

enum OrgPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum OrgStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  PENDING
}

enum InvoiceStatus {
  PENDING
  PAID
  OVERDUE
  CANCELLED
  VOID
}

enum DbStrategy {
  SHARED
  DEDICATED
}

model ActivityLog {
  id             String  @id @default(uuid())
  userId         String
  organizationId String?
  action         String
  entity         String
  entityId       String?
  details        Json?
  // New optional link to a project for project‑related actions
  projectId      String?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
