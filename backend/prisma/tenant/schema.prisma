generator client {
  provider      = "prisma-client-js"
  output        = "../../generated/tenant-client"
  binaryTargets = ["native", "debian-openssl-1.1.x", "debian-openssl-3.0.x", "linux-musl", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("TENANT_DATABASE_URL")
}

// ─── Organization ──────────────────────────────────────────────────────────
model Organization {
  id   String @id @default(uuid())
  name String

  plan        OrgPlan   @default(FREE)
  status      OrgStatus @default(TRIAL)
  maxUsers    Int       @default(10)
  maxProjects Int       @default(5)

  logoUrl    String?
  themeColor String?  @default("#3B82F6")

  industry String?
  size     String?
  website  String?
  country  String?
  timezone String?  @default("Asia/Kolkata")

  billingEmail        String?
  primaryContactName  String?
  primaryContactPhone String?
  address             String?

  trialEndsAt     DateTime?
  suspendedAt     DateTime?
  suspendedReason String?

  requireApproval      Boolean @default(false)
  allowClientSignup    Boolean @default(false)
  sessionTimeoutMinutes Int?
  rolePermissions      Json?

  customFeatures Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  users         User[]
  projects      Project[]
  tickets       Ticket[]
  chatMessages  ChatMessage[]
  chatRoomLastSeen ChatRoomLastSeen[]
  activityLogs  ActivityLog[]
  notifications Notification[]
  attendances   Attendance[]
}

// ─── User ───────────────────────────────────────────────────────────────────
model User {
  id             String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name         String
  email        String
  passwordHash String
  role         Role     @default(MEMBER)
  avatar       String?

  isApproved         Boolean  @default(false)
  mustChangePassword Boolean  @default(true)

  resetToken       String?
  resetTokenExpiry DateTime?

  // Self relation (manager)
  managerId String?
  manager   User?   @relation("ManagerRelation", fields: [managerId], references: [id], onDelete: SetNull)
  members   User[]  @relation("ManagerRelation")

  managedProjects  Project[]  @relation("ProjectManager")
  clientProjects   Project[]  @relation("ProjectClient")
  workloads        Workload[]

  taskAssignments TaskAssignee[]
  workLogs        WorkLog[]
  timeEntries     TimeEntry[]

  tickets        Ticket[]        @relation("UserTickets")
  ticketComments TicketComment[]
  taskComments   TaskComment[]

  chatMessages     ChatMessage[]
  chatRoomLastSeen ChatRoomLastSeen[]
  activityLogs     ActivityLog[]
  notifications    Notification[]
  attendances      Attendance[]

  createdAt DateTime @default(now())
  updatedAt DateTime? @updatedAt

  authoredDocuments Document[]

  @@unique([email, organizationId])
}

// ─── Project ────────────────────────────────────────────────────────────────
model Project {
  id             String @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  name        String
  description String?
  category    String?  @default("INTERNAL")

  managerId String?
  manager   User?   @relation("ProjectManager", fields: [managerId], references: [id], onDelete: SetNull)

  clientId String?
  client   User?   @relation("ProjectClient", fields: [clientId], references: [id], onDelete: SetNull)

  status    ProjectStatus @default(PLANNING)
  startDate DateTime?
  endDate   DateTime?

  totalBudget Decimal?  @db.Decimal(12, 2)
  usedBudget  Decimal   @default(0) @db.Decimal(12, 2)

  phases    Phase[]
  tasks     Task[]
  workloads Workload[]
  workLogs  WorkLog[]
  timeEntries TimeEntry[]

  githubRepo           String?  // e.g., "owner/repo"
  githubInstallationId String? 

  allowMemberTaskCreation Boolean @default(false)
  
  prefix String? // Short code for Jira-style IDs (e.g. PROJ)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  
  documents Document[]
}

// ─── Phase ──────────────────────────────────────────────────────────────────
model Phase {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  name                 String
  status               PhaseStatus @default(WAITING)
  completionPercentage Int         @default(0)
  order                Int
  startDate            DateTime?
  endDate              DateTime?

  tasks Task[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ─── Task ───────────────────────────────────────────────────────────────────
model Task {
  id          String   @id @default(uuid())
  projectId   String
  phaseId     String?
  shortId     String?  // e.g., PROJ-123
  taskNumber  Int?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase   Phase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)

  title       String
  description String?
  status      TaskStatus @default(TODO)
  rejectionReason String?
  priority    Priority   @default(MEDIUM)
  type        TaskType   @default(TASK)

  completionPercentage Int @default(0)
  storyPoints          Int?
  completedAt          DateTime?

  dueDate DateTime?
  tags    String[]  @default([])
  attachments Json @default("[]")

  assignees   TaskAssignee[]
  workLogs    WorkLog[]
  timeEntries TimeEntry[]
  comments    TaskComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ─── TaskAssignee ───────────────────────────────────────────────────────────
model TaskAssignee {
  id     String @id @default(uuid())
  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
}

// ─── TaskComment ───────────────────────────────────────────────────────────
model TaskComment {
  id        String   @id @default(uuid())
  taskId    String
  userId    String
  content   String

  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ─── WorkLog ────────────────────────────────────────────────────────────────
model WorkLog {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  taskId    String

  minutes  Int
  comment  String?
  loggedAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── TimeEntry ──────────────────────────────────────────────────────────────
model TimeEntry {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  taskId    String

  date        DateTime
  hours       Float
  description String?
  status      TimeEntryStatus @default(PENDING)
  billable    Boolean         @default(false)
  isManual    Boolean         @default(false)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task    Task    @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── Workload ───────────────────────────────────────────────────────────────
model Workload {
  userId    String
  projectId String

  workloadPercentage Int @default(0)
  calculatedAt       DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@unique([userId, projectId])
}

// ─── Ticket ─────────────────────────────────────────────────────────────────
model Ticket {
  id             String   @id @default(uuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  title       String
  description String?
  status      TicketStatus @default(OPEN)
  priority    Priority     @default(MEDIUM)

  clientId String
  client   User   @relation("UserTickets", fields: [clientId], references: [id], onDelete: Cascade)

  comments TicketComment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ─── TicketComment ──────────────────────────────────────────────────────────
model TicketComment {
  id       String @id @default(uuid())
  ticketId String
  userId   String

  message String

  ticket Ticket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
}

// ─── ChatMessage ────────────────────────────────────────────────────────────
model ChatMessage {
  id             String   @id @default(uuid())
  content        String
  userId         String
  projectId      String?
  organizationId String?
  isEdited       Boolean  @default(false)
  
  // New fields
  parentId       String?
  reactions      Json?    // { emoji: [userIds] } or { emoji: count }
  isForwarded    Boolean  @default(false)

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Self relation for replies
  parent       ChatMessage?  @relation("MessageReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies      ChatMessage[] @relation("MessageReplies")

  createdAt DateTime @default(now())
}

// ─── ChatRoomLastSeen ───────────────────────────────────────────────────────
model ChatRoomLastSeen {
  id             String   @id @default(uuid())
  userId         String
  projectId      String?
  organizationId String?
  lastSeen       DateTime @default(now())

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId, organizationId])
}

// ─── ActivityLog ────────────────────────────────────────────────────────────
model ActivityLog {
  id             String  @id @default(uuid())
  userId         String
  projectId      String?
  organizationId String?
  action         String
  entity         String
  entityId       String?
  details        Json?

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── Notification ───────────────────────────────────────────────────────────
model Notification {
  id             String  @id @default(uuid())
  userId         String
  organizationId String?

  title   String
  message String
  type    String
  link    String?
  isRead  Boolean @default(false)
  readAt  DateTime?

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── Attendance ─────────────────────────────────────────────────────────────
model Attendance {
  id             String   @id @default(uuid())
  userId         String
  organizationId String
  clockIn        DateTime @default(now())
  clockOut       DateTime?
  status         String   @default("ACTIVE") // ACTIVE, COMPLETED
  durationMinutes Int?
  
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

// ─── Enums ──────────────────────────────────────────────────────────────────
enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  MEMBER
  CLIENT
}

enum OrgPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum OrgStatus {
  TRIAL
  ACTIVE
  SUSPENDED
  PENDING
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  COMPLETED
  ON_HOLD
  CANCELLED
}

enum PhaseStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskType {
  TASK
  BUG
  STORY
  EPIC
  SUBTASK
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum TimeEntryStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── Document (Native Wiki / Docs) ──────────────────────────────────────────
model Document {
  id          String   @id @default(uuid())
  projectId   String
  authorId    String
  
  title       String
  content     String   @db.Text
  attachments Json     @default("[]")
  
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now()) @updatedAt
}