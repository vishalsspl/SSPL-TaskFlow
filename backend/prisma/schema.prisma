// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  logoUrl     String?  @map("logo_url")
  themeColor  String?  @default("#3B82F6") @map("theme_color")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users       User[]
  projects    Project[]

  @@map("organizations")
}

enum Role {
  ADMIN
  MANAGER
  MEMBER
  CLIENT
}

model User {
  id            String   @id @default(uuid())
  organizationId String   @map("organization_id")
  name          String
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          Role     @default(MEMBER)
  isApproved    Boolean  @default(false) @map("is_approved")
  avatar        String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTasks Task[]
  workloads     Workload[]
  activityLogs  ActivityLog[]
  managedProjects Project[]
  clientProjects  Project[] @relation("ClientProjects")

  @@map("users")
}

enum ProjectStatus {
  PLANNING
  ACTIVE
  ON_HOLD
  COMPLETED
  CANCELLED
}

model Project {
  id            String        @id @default(uuid())
  organizationId String        @map("organization_id")
  name          String
  description   String?
  clientId      String?       @map("client_id")
  startDate     DateTime?     @map("start_date")
  endDate       DateTime?     @map("end_date")
  totalBudget   Decimal?      @map("total_budget") @db.Decimal(12, 2)
  usedBudget    Decimal       @default(0) @map("used_budget") @db.Decimal(12, 2)
  status        ProjectStatus @default(PLANNING)
  managerId     String?       @map("manager_id")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  organization  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client        User?        @relation("ClientProjects", fields: [clientId], references: [id], onDelete: SetNull)
  manager       User?        @relation(fields: [managerId], references: [id], onDelete: SetNull)
  phases        Phase[]
  tasks         Task[]
  workloads     Workload[]
  activityLogs  ActivityLog[]

  @@map("projects")
}

enum PhaseStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
}

model Phase {
  id                   String      @id @default(uuid())
  projectId            String      @map("project_id")
  name                 String
  status               PhaseStatus @default(WAITING)
  completionPercentage Int         @default(0) @map("completion_percentage")
  order                Int
  startDate            DateTime?   @map("start_date")
  endDate              DateTime?   @map("end_date")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     Task[]

  @@map("phases")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  COMPLETED
  BLOCKED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Task {
  id                   String       @id @default(uuid())
  projectId            String       @map("project_id")
  phaseId              String?      @map("phase_id")
  title                String
  description          String?
  assignedTo           String?      @map("assigned_to")
  status               TaskStatus   @default(TODO)
  priority             TaskPriority @default(MEDIUM)
  completionPercentage Int          @default(0) @map("completion_percentage")
  dueDate              DateTime?    @map("due_date")
  tags                 String[]     @default([])
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase    Phase?  @relation(fields: [phaseId], references: [id], onDelete: SetNull)
  assignee User?   @relation(fields: [assignedTo], references: [id], onDelete: SetNull)

  @@map("tasks")
}

model Workload {
  userId              String   @map("user_id")
  projectId           String   @map("project_id")
  workloadPercentage  Int      @default(0) @map("workload_percentage")
  calculatedAt        DateTime @default(now()) @map("calculated_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([userId, projectId])
  @@map("workloads")
}

model ActivityLog {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  projectId String?  @map("project_id")
  action    String
  entity    String
  entityId  String?  @map("entity_id")
  details   Json?
  createdAt DateTime @default(now()) @map("created_at")

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("activity_logs")
}
