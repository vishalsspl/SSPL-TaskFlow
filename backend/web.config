<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- Let Node.js handle its own errors instead of IIS error pages -->
    <httpErrors existingResponse="PassThrough" />

    <!-- Route all requests through iisnode via server.js -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <rewrite>
      <rules>
        <!-- All requests go through Node.js server -->
        <rule name="NodeJsApp">
          <match url=".*" />
          <conditions logicalGrouping="MatchAll">
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <security>
      <requestFiltering>
        <hiddenSegments>
          <!-- Hide sensitive directories from being served directly -->
          <add segment="node_modules" />
          <add segment="src" />
          <add segment="prisma" />
          <add segment="iisnode" />
        </hiddenSegments>
      </requestFiltering>
    </security>

    <!-- Enable WebSocket support for Socket.IO -->
    <webSocket enabled="true" />

    <iisnode
      watchedFiles="server.js;web.config"
      nodeProcessCommandLine="node"
      loggingEnabled="true"
      logDirectory="iisnode"
      devErrorsEnabled="false"
      node_env="production" />

  </system.webServer>
</configuration>
 
