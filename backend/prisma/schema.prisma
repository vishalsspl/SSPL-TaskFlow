generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id   String @id @default(uuid())
  name String

  // 🔥 tenant connection
  dbUrl      String
  dbStrategy DbStrategy @default(DEDICATED)

  // plan & limits
  plan        OrgPlan   @default(FREE)
  status      OrgStatus @default(TRIAL)
  maxUsers    Int       @default(10)
  maxProjects Int       @default(5)

  // billing
  billingEmail String?
  trialEndsAt  DateTime?

  // metadata
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices Invoice[]

  // 🔥 ADD THIS LINE
  users User[]
}

model User {
  id           String @id @default(uuid())
  email        String @unique
  passwordHash String
  role         Role

  // optional org link (for admin mapping)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])

  createdAt DateTime @default(now())
}

model Invoice {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  amount Float
  status InvoiceStatus
  plan   OrgPlan

  dueDate DateTime?
  paidAt  DateTime?

  createdAt DateTime @default(now())
}

model PlatformSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

enum Role {
  SUPERADMIN
}

enum OrgPlan {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

enum OrgStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

enum InvoiceStatus {
  PENDING
  PAID
  FAILED
}

enum DbStrategy {
  SHARED
  DEDICATED
}
