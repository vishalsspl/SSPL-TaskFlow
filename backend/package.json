{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for Task Management Platform",
  "main": "src/server.js",
  "type": "module",
  "prisma": {
    "seed": "node prisma/seed.js"
  },
  "scripts": {
    "dev": "powershell -Command \"Get-NetTCPConnection -LocalPort 5000 -ErrorAction SilentlyContinue | Where-Object { $_.OwningProcess -gt 4 } | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\" & nodemon src/server.js",
    "start": "node src/server.js",
    "db:migrate": "prisma migrate dev",
    "db:migrate:tenant": "prisma migrate dev --schema=prisma/tenant/schema.prisma",
    "db:seed": "node prisma/seed.js",
    "db:studio": "prisma studio",
    "db:studio:tenant": "prisma studio --schema=prisma/tenant/schema.prisma",
    "db:generate": "prisma generate",
    "db:generate:tenant": "prisma generate --schema=prisma/tenant/schema.prisma",
    "db:generate:all": "prisma generate && prisma generate --schema=prisma/tenant/schema.prisma",
    "db:seed_random": "node prisma/seed_random.js",
    "db:provision": "node scripts/provision-tenant-db.js"
  },
  "dependencies": {
    "@octokit/rest": "^22.0.1",
    "@prisma/client": "^5.22.0",
    "axios": "^1.15.2",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "nodemailer": "^8.0.1",
    "otplib": "^13.4.0",
    "pg": "^8.20.0",
    "puppeteer": "^21.11.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.6",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "prisma": "^5.22.0"
  }
}
